{
  "$schema": "./node_modules/@mentra/miniapp-cli/schema/miniapp.schema.json",
  "packageName": "com.mentra.snaptrack",
  "version": "1.0.0",
  "name": "SnapTrack",
  "description": "Snap a meal photo, get calories and macros on your HUD",
  "icon": "icon.png",
  "type": "standard",
  "sdkVersion": "0.3.0",
  "minHostVersion": "1.42.0",
  "entry": {
    "background": "background/index.js",
    "ui": "ui/index.html"
  },
  "permissions": [],
  "hardwareRequirements": [
    {"type": "CAMERA", "level": "REQUIRED", "description": "Captures the meal photo to analyze"},
    {"type": "DISPLAY", "level": "REQUIRED", "description": "Shows calories and macros on the HUD"}
  ]
}
