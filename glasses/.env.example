# Copy to .env (gitignored) and fill in the real value.
# build.ts inlines this into the built background/UI bundles at build time -
# it is NOT a runtime secret store, just a way to keep the plaintext value
# out of git. The built bundle still contains it in plaintext.
#
# Use YOUR personal API token from /account (sign up on the web app first) -
# captures log to your own account. The shared site password also works but
# won't be tied to any specific account. See glasses/README.md.
MENTRA_PUBLIC_APP_KEY=your-personal-api-token-or-site-password
